rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada pessoa lê e grava só o próprio progresso, e só os e-mails liberados abaixo.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid
        && request.auth.token.email in ["COLE_SEU_EMAIL@gmail.com", "COLE_EMAIL_DA_ESPOSA@gmail.com"];
    }
  }
}
